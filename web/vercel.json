{
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?!devklean\\.vercel\\.app$)(?!devklean\\.smurftyy\\.dev$).+\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "devklean.vercel.app"
        }
      ],
      "destination": "https://devklean.smurftyy.dev/:path*",
      "permanent": true
    }
  ]
}
